# Cloudflare Worker Deployment
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
UUID=your_vless_uuid

# Secret Panel Path (default: wp_panel)
PANEL_PATH=wp_panel

# Optional: Password/Token protection for the web panel and subscriptions
PANEL_TOKEN=your_secret_password

# Root & Unauthenticated fallback redirect URL (default: https://www.youtube.com)
REDIRECT_URL=https://www.youtube.com

# Optional: Custom Node Prefix
NODE_PREFIX=wp-edge - 

# Optional: Outbound Proxy IP for Cloudflare IP bypass
# PROXY_IP=

# Optional: Comma-separated clean IPs
# CLEAN_IPS=104.16.0.0,162.159.0.0,icook.hk,speed.cloudflare.com
